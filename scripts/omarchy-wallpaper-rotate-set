#!/usr/bin/env bash
# ==============================================================================
# Configure and run wallpaper rotation reliably across any Omarchy system
# ==============================================================================

set -euo pipefail

interval="${1:-}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-wallpaper"
interval_file="$state_dir/interval"
pid_file="$state_dir/daemon.pid"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

mkdir -p "$state_dir"

stop_daemon() {
  if [[ -f "$pid_file" ]]; then
    local pid
    pid="$(cat "$pid_file" 2>/dev/null || echo "")"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$pid_file" 2>/dev/null || true
  fi

  # Stop any lingering rotation daemon processes
  pkill -f "omarchy-wallpaper-rotate-daemon" 2>/dev/null || true
}

start_daemon() {
  stop_daemon
  nohup "$script_dir/omarchy-wallpaper-rotate-daemon" >/dev/null 2>&1 &
}

case "$interval" in
  off)
    printf 'off\n' > "$interval_file"
    stop_daemon
    notify-send -u low "Wallpaper rotation" "Automatic wallpaper rotation disabled" >/dev/null 2>&1 || true
    exit 0
    ;;
  30s|1m|5m|10m|18m|30m)
    printf '%s\n' "$interval" > "$interval_file"
    start_daemon
    notify-send -u low "Wallpaper rotation" "Automatic wallpaper rotation set to $interval" >/dev/null 2>&1 || true
    exit 0
    ;;
  *)
    echo "Usage: omarchy-wallpaper-rotate-set {off|30s|1m|5m|10m|18m|30m}" >&2
    exit 1
    ;;
esac
