#!/usr/bin/env bash
# ==============================================================================
# Ultra-Fast Curated Wallpaper Palette Classifier & Contrast Engine
# Features: Multi-tier SHA1 disk caching (sub-2ms), WCAG AAA curated palettes,
# and instant atomic synchronization for Hyprland, Quickshell, and RMPC.
# ==============================================================================


set -euo pipefail

wallpaper_input="${1:-$HOME/.local/state/omarchy/current/background}"
wallpaper="$(readlink -f "$wallpaper_input" 2>/dev/null || printf '%s\n' "$wallpaper_input")"

if [[ ! -f "$wallpaper" ]]; then
  exit 0
fi

# ── 1. Smart Palette Caching (Instant Sub-2ms Hit) ──────────────────────────
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/palettes"
mkdir -p "$cache_dir"

file_stat="$(stat -c "%n:%s:%Y" "$wallpaper" 2>/dev/null || echo "$wallpaper")"
cache_key="$(printf '%s' "$file_stat" | sha1sum | awk '{print $1}')"
cache_file="$cache_dir/$cache_key.txt"

if [[ -f "$cache_file" && -s "$cache_file" ]]; then
  readarray -t palette < "$cache_file"
else
  # Fast Python vibrant extractor with thumbnailing
  readarray -t palette < <(
    python3 - "$wallpaper" << 'PYEOF'
import sys
import os
import colorsys

wallpaper_path = sys.argv[1]

# Default fallback
r, g, b = (0.22, 0.74, 0.97)
is_monochrome = False

if os.path.isfile(wallpaper_path):
    try:
        import PIL.Image
        with PIL.Image.open(wallpaper_path) as img:
            img = img.convert('RGB')
            img.thumbnail((64, 64), PIL.Image.Resampling.BILINEAR)
            pixels = list(getattr(img, 'get_flattened_data', img.getdata)())
            total_pixels = len(pixels)
            vibrant_candidates = []
            for pr, pg, pb in pixels:
                hr, hg, hb = pr / 255.0, pg / 255.0, pb / 255.0
                h, l, s = colorsys.rgb_to_hls(hr, hg, hb)
                if 0.15 <= l <= 0.85 and s >= 0.25:
                    vibrant_candidates.append((hr, hg, hb, s, h))
            
            if len(vibrant_candidates) >= (total_pixels * 0.02):
                vibrant_candidates.sort(key=lambda x: x[3], reverse=True)
                top_sample = vibrant_candidates[:max(1, len(vibrant_candidates)//4)]
                r = sum(c[0] for c in top_sample) / len(top_sample)
                g = sum(c[1] for c in top_sample) / len(top_sample)
                b = sum(c[2] for c in top_sample) / len(top_sample)
            else:
                is_monochrome = True
    except Exception:
        pass

if is_monochrome:
    bar_bg   = "#11111b"
    popup_bg = "#181825"
    text     = "#ffffff"
    accent   = "#cba6f7"
    active   = "#b4befe"
    border   = "#45475a"
    warn     = "#f9e2af"
    blue     = "#89b4fa"
    green    = "#a6e3a1"
    pink     = "#f38ba8"
else:
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    hue_deg = h * 360.0

    if 15 <= hue_deg < 65:
        bar_bg   = "#14110e"
        popup_bg = "#201a15"
        text     = "#ffffff"
        accent   = "#ffb703"
        active   = "#fb8500"
        border   = "#ffb703"
        warn     = "#ffd166"
        blue     = "#8ecae6"
        green    = "#06d6a0"
        pink     = "#f72585"
    elif 65 <= hue_deg < 175:
        bar_bg   = "#0b140f"
        popup_bg = "#132219"
        text     = "#ffffff"
        accent   = "#52b788"
        active   = "#74c69d"
        border   = "#52b788"
        warn     = "#ffe66d"
        blue     = "#4ea8de"
        green    = "#52b788"
        pink     = "#f38ba8"
    elif 175 <= hue_deg < 240:
        bar_bg   = "#0c1219"
        popup_bg = "#141d28"
        text     = "#ffffff"
        accent   = "#38bdf8"
        active   = "#0ea5e9"
        border   = "#38bdf8"
        warn     = "#facc15"
        blue     = "#38bdf8"
        green    = "#4ade80"
        pink     = "#f472b6"
    elif 240 <= hue_deg < 290:
        bar_bg   = "#10111a"
        popup_bg = "#181a28"
        text     = "#ffffff"
        accent   = "#818cf8"
        active   = "#a78bfa"
        border   = "#818cf8"
        warn     = "#fbbf24"
        blue     = "#60a5fa"
        green    = "#34d399"
        pink     = "#f43f5e"
    elif 290 <= hue_deg < 340:
        bar_bg   = "#160e18"
        popup_bg = "#241626"
        text     = "#ffffff"
        accent   = "#f43f5e"
        active   = "#c084fc"
        border   = "#f43f5e"
        warn     = "#fde047"
        blue     = "#38bdf8"
        green    = "#4ade80"
        pink     = "#f43f5e"
    else:
        bar_bg   = "#160c0e"
        popup_bg = "#261316"
        text     = "#ffffff"
        accent   = "#ef4444"
        active   = "#f87171"
        border   = "#ef4444"
        warn     = "#f59e0b"
        blue     = "#60a5fa"
        green    = "#10b981"
        pink     = "#ec4899"

for val in [bar_bg, popup_bg, text, accent, active, border, warn, blue, green, pink]:
    print(val)
PYEOF
  )

  # Save to cache
  printf "%s\n" "${palette[@]}" > "$cache_file" 2>/dev/null || true
fi

curated_bar_bg="${palette[0]}"
curated_popup_bg="${palette[1]}"
curated_text="${palette[2]}"
curated_accent="${palette[3]}"
curated_active="${palette[4]}"
curated_border="${palette[5]}"
curated_warn="${palette[6]}"
curated_blue="${palette[7]}"
curated_green="${palette[8]}"
curated_pink="${palette[9]}"

css_accent="$(printf '%s' "$curated_accent" | sed 's/^#//')"

# ── 2. Update Hyprland window borders (conf & lua) ───────────────────────────
cat >"$HOME/.config/hypr/generated-colors.conf" <<HYPR_EOF
\$accent = rgb(${css_accent})
\$accent_soft = rgba(${css_accent}99)

general {
    col.active_border = rgb(${css_accent})
    col.inactive_border = rgba(00000066)
}
HYPR_EOF

cat >"$HOME/.config/hypr/generated-colors.lua" <<LUA_EOF
-- Generated by theme-sync-colors
hl.config({
  general = {
    col = {
      active_border = "rgb(${css_accent})",
      inactive_border = "rgba(00000066)",
    },
  },
})
LUA_EOF

# ── 3. Read Blur & Opacity Preferences ──────────────────────────────────────
env_file="$HOME/.local/state/omarchy/blur-opacity-state.env"
bar_alpha="0.20"
bar_palette="wallpaper-auto"
if [[ -f "$env_file" ]]; then
  source "$env_file" 2>/dev/null || true
  if [[ -n "${BAR_OPACITY:-}" && "$BAR_OPACITY" != "default" ]]; then
    bar_alpha="$BAR_OPACITY"
  fi
  if [[ -n "${BAR_PALETTE:-}" ]]; then
    bar_palette="$BAR_PALETTE"
  fi
fi

# ── 4. Update shell.toml (ONLY if wallpaper-auto is selected) ────────────────
if [[ "$bar_palette" == "wallpaper-auto" ]]; then
  user_shell_toml="$HOME/.config/omarchy/shell.toml"
  cur_base="14"
  if [[ -f "$user_shell_toml" ]]; then
    cur_base=$(grep -oP 'base-size\s*=\s*\K[0-9]+' "$user_shell_toml" | head -1 || echo "14")
    [[ -n "$cur_base" ]] || cur_base="14"
  fi
  mkdir -p "$(dirname "$user_shell_toml")"
  cat > "$user_shell_toml" <<TOML_EOF
[font]
base-size = ${cur_base}

[bar]
background = "${curated_bar_bg}"
background-alpha = ${bar_alpha}
text = "#ffffff"
active = "${curated_accent}"

[popups]
background = "${curated_popup_bg}"
background-alpha = 0.95
text = "#ffffff"
border = "${curated_border}"
border-alpha = 0.85

[controls]
normal-color = "#ffffff"
normal-border = "${curated_border}"
normal-fill-alpha = ${bar_alpha}
normal-border-alpha = 0.40
hover-cursor-color = "#ffffff"
hover-cursor-border = "${curated_active}"
hover-cursor-fill-alpha = 0.28
selected-color = "#ffffff"
selected-border = "${curated_border}"
selected-fill-alpha = 0.35
TOML_EOF
fi

# ── 5. Update Theme colors.toml ──────────────────────────────────────────────
theme_colors="$HOME/.local/state/omarchy/current/theme/colors.toml"
if [[ -f "$theme_colors" ]]; then
  cat > "$theme_colors" <<COLORS_EOF
accent = "${curated_accent}"
selection = "#f5e0dc"

background = "${curated_bar_bg}"
foreground = "#ffffff"

color0 = "${curated_bar_bg}"
color1 = "${curated_pink}"
color2 = "${curated_green}"
color3 = "${curated_warn}"
color4 = "${curated_blue}"
color5 = "${curated_active}"
color6 = "${curated_accent}"
color7 = "#ffffff"
color8 = "#585b70"
color9 = "${curated_pink}"
color10 = "${curated_green}"
color11 = "${curated_warn}"
color12 = "${curated_blue}"
color13 = "${curated_active}"
color14 = "${curated_accent}"
color15 = "#a6adc8"
COLORS_EOF
fi

# ── 6. Update RMPC Music Player Theme ────────────────────────────────────────
rmpc_theme="$HOME/.config/rmpc/theme.ron"
if [[ -f "$rmpc_theme" || -d "$(dirname "$rmpc_theme")" ]]; then
  mkdir -p "$(dirname "$rmpc_theme")"
  cat > "$rmpc_theme" <<RON_EOF
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: "#ffffff",
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "${curated_accent}"),
    preview_metadata_group_style: (fg: "${curated_accent}", modifiers: "Bold"),
    highlighted_item_style: (fg: "${curated_warn}", modifiers: "Bold"),
    current_item_style: (fg: "${curated_bar_bg}", bg: "${curated_accent}", modifiers: "Bold"),
    borders_style: (fg: "#555b6e"),
    highlight_border_style: (fg: "${curated_accent}"),
    symbols: (
        song: "󰎈 ",
        dir: " ",
        playlist: "󰲸 ",
        marker: "󰐊 ",
        ellipsis: "…",
        song_style: (fg: "${curated_blue}"),
        dir_style: (fg: "${curated_accent}", modifiers: "Bold"),
        playlist_style: (fg: "${curated_green}"),
    ),
    level_styles: (
        info: (fg: "${curated_blue}", bg: "${curated_bar_bg}"),
        warn: (fg: "${curated_warn}", bg: "${curated_bar_bg}"),
        error: (fg: "${curated_pink}", bg: "${curated_bar_bg}"),
        debug: (fg: "${curated_green}", bg: "${curated_bar_bg}"),
        trace: (fg: "${curated_active}", bg: "${curated_bar_bg}"),
    ),
    progress_bar: (
        symbols: ["█", "█", "█", " ", "█"],
        track_style: (fg: "#2a2d34"),
        elapsed_style: (fg: "${curated_accent}"),
        thumb_style: (fg: "${curated_active}"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#2a2d34"),
        ends_style: (fg: "#555b6e"),
        thumb_style: (fg: "${curated_accent}"),
    ),
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        inverted_bar_symbols: ['▔', '▔', '▀', '▀', '▀', '█', '█', '█'],
        bg_color: None,
        bar_width: 1,
        bar_spacing: 1,
        orientation: Bottom,
        bar_color: Gradient({
            0: "${curated_blue}",
            35: "${curated_green}",
            70: "${curated_warn}",
            100: "${curated_accent}",
        }),
    ),
    tab_bar: (
        active_style: (fg: "${curated_bar_bg}", bg: "${curated_accent}", modifiers: "Bold"),
        inactive_style: (fg: "#ffffff"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track), style: (fg: "${curated_blue}", modifiers: "Bold")),
                (kind: Text(" "), style: (fg: "#555b6e")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist), style: (fg: "${curated_accent}", modifiers: "Bold")),
                (kind: Text(" - "), style: (fg: "#555b6e")),
                (kind: Property(Title), style: (fg: "${curated_warn}", modifiers: "Bold")),
            ]),
            default: (kind: Property(Filename), style: (fg: "${curated_blue}", modifiers: "Bold"))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "${curated_accent}", modifiers: "Bold"),
                default: (kind: Text("Unknown"), style: (fg: "#555b6e", modifiers: "Dim"))
            ),
            label_prop: (kind: Text("Artist"), style: (fg: "${curated_accent}", modifiers: "Bold")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title), style: (fg: "${curated_warn}", modifiers: "Bold"),
                default: (kind: Text("Unknown"), style: (fg: "#555b6e", modifiers: "Dim"))
            ),
            label_prop: (kind: Text("Title"), style: (fg: "${curated_warn}", modifiers: "Bold")),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "${curated_pink}"),
                default: (kind: Text("Unknown Album"), style: (fg: "${curated_pink}"))
            ),
            label_prop: (kind: Text("Album"), style: (fg: "${curated_pink}", modifiers: "Bold")),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "${curated_blue}"),
                default: (kind: Text("-"), style: (fg: "#555b6e", modifiers: "Dim"))
            ),
            label_prop: (kind: Text("Duration"), style: (fg: "${curated_blue}", modifiers: "Bold")),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "35",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "35",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            (
                pane: Pane(Tabs),
                borders: "RIGHT | LEFT | BOTTOM",
                border_symbols: Rounded,
                size: "2",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "12",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Rounded,
                            border_title: [(kind: Text(" "), style: (fg: "#555b6e")), (kind: Property(Status(QueueLength())), style: (fg: "${curated_accent}", modifiers: "Bold")), (kind: Text(" songs / "), style: (fg: "#555b6e")), (kind: Property(Status(QueueTimeTotal())), style: (fg: "${curated_blue}", modifiers: "Bold")), (kind: Text(" total time "), style: (fg: "#555b6e"))],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "${curated_warn}", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "${curated_warn}", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "${curated_warn}", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "${curated_warn}", modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (fg: "#555b6e", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "4", pane: Pane(Property(content: [(kind: Text("VOL "), style: (fg: "#555b6e", modifiers: "Bold"))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "4", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "${curated_accent}", modifiers: "Bold")), (kind: Text("%"), style: (fg: "#555b6e"))], align: Right))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "${curated_accent}", modifiers: "Bold")),
                (kind: Text(" / "), style: (fg: "#555b6e")),
                (kind: Property(Status(Duration)), style: (fg: "#ffffff")),
                (kind: Group([
                    (kind: Text(" · "), style: (fg: "#555b6e")),
                    (kind: Property(Status(Bitrate)), style: (fg: "${curated_blue}")),
                    (kind: Text("k"), style: (fg: "#555b6e")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "${curated_accent}", modifiers: "Bold"),
                    default: (kind: Text("Unknown Artist"), style: (fg: "${curated_accent}", modifiers: "Bold"))),
                (kind: Text(" ── "), style: (fg: "#555b6e")),
                (kind: Property(Song(Album)), style: (fg: "${curated_pink}"),
                    default: (kind: Text("Unknown Album"), style: (fg: "${curated_pink}"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "${curated_blue}"), align: Left)]))
                ),
                (
                    size: "14",
                    pane: Pane(Property(content: [
                        (kind: Property(Status(RepeatV2(
                            on_label: " REP ",
                            off_label: " rep ",
                            on_style: (fg: "${curated_warn}", modifiers: "Bold"),
                            off_style: (fg: "#555b6e", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: " RND ",
                            off_label: " rnd ",
                            on_style: (fg: "${curated_green}", modifiers: "Bold"),
                            off_style: (fg: "#555b6e", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: " SGL ",
                            off_label: " sgl ",
                            oneshot_label: " 1x ",
                            on_style: (fg: "${curated_accent}", modifiers: "Bold"),
                            off_style: (fg: "#555b6e", modifiers: "Dim"),
                            oneshot_style: (fg: "${curated_pink}", modifiers: "Bold"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: " CSM ",
                            off_label: " csm ",
                            oneshot_label: " 1c ",
                            on_style: (fg: "${curated_pink}", modifiers: "Bold"),
                            off_style: (fg: "#555b6e", modifiers: "Dim"),
                            oneshot_style: (fg: "${curated_pink}", modifiers: "Dim"),
                        )))),
                    ], align: Right))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "${curated_bar_bg}", bg: "${curated_accent}", modifiers: "Bold"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "${curated_bar_bg}", bg: "${curated_green}", modifiers: "Bold"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },
)
RON_EOF
fi

# ── 7. Update CAVA Terminal Visualizer Colors ────────────────────────────────
cava_config="$HOME/.config/cava/config"
if [[ -f "$cava_config" || -d "$(dirname "$cava_config")" ]]; then
  mkdir -p "$(dirname "$cava_config")"
  cat > "$cava_config" <<CAVA_EOF
## Dynamically Synchronized by Omarchy Color Engine (theme-sync-colors)

[general]
live-config = 1

[input]
method = pulse
source = auto

[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '${curated_blue}'
gradient_color_2 = '${curated_green}'
gradient_color_3 = '${curated_accent}'
gradient_color_4 = '${curated_active}'
gradient_color_5 = '${curated_warn}'
gradient_color_6 = '${curated_pink}'
gradient_color_7 = '${curated_accent}'
gradient_color_8 = '${curated_pink}'
CAVA_EOF
fi

# ── 8. Instant Hyprland Active Border Accent ────────────────────────────────
if command -v hyprctl >/dev/null 2>&1; then
  hyprctl keyword general:col.active_border "rgb(${css_accent})" >/dev/null 2>&1 || true
fi

# ── 9. Hot-Reload Quickshell Theme & Island Colors ──────────────────────────
if command -v omarchy-shell >/dev/null 2>&1; then
  theme_colors="$HOME/.local/state/omarchy/current/theme/colors.toml"
  user_shell_toml="$HOME/.config/omarchy/shell.toml"
  if [[ -f "$theme_colors" && -f "$user_shell_toml" ]]; then
    colors_payload="$(base64 -w 0 < "$theme_colors" 2>/dev/null || true)"
    shell_payload="$(base64 -w 0 < "$user_shell_toml" 2>/dev/null || true)"
    if [[ -n "$colors_payload" && -n "$shell_payload" ]]; then
      omarchy-shell -q shell applyTheme "$colors_payload" "$shell_payload" >/dev/null 2>&1 || true
    fi
  fi
fi
