#!/usr/bin/env bash
# ==============================================================================
# Query wallpaper rotation status and ensure daemon persistence
# ==============================================================================

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-wallpaper"
interval_file="$state_dir/interval"
pid_file="$state_dir/daemon.pid"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

value="$(cat "$interval_file" 2>/dev/null || echo "off")"

case "$value" in
  30s|1m|5m|10m|18m|30m)
    # Check if daemon is running; if not, resume it
    is_running=false
    if [[ -f "$pid_file" ]]; then
      pid="$(cat "$pid_file" 2>/dev/null || echo "")"
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        is_running=true
      fi
    fi
    if [[ "$is_running" == false ]]; then
      nohup "$script_dir/omarchy-wallpaper-rotate-daemon" >/dev/null 2>&1 &
    fi
    echo "$value"
    ;;
  off|*)
    echo "off"
    ;;
esac
