#!/usr/bin/env bash
# Independent Terminal Typography Scaler for Foot, Ghostty, Kitty, Alacritty


source ~/.local/lib/omarchy-user-env.sh 2>/dev/null || true

set -euo pipefail

STATE_FILE="$HOME/.local/state/omarchy/terminal-font-size"
MIN=8
MAX=24

get_size() {
  if [[ -f "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    echo "11"
  fi
}

set_size() {
  local pt="$1"
  local mono_family
  mono_family="$(omarchy-font-current 2>/dev/null || echo "Adwaita Mono")"
  [[ -n "$mono_family" ]] || mono_family="Adwaita Mono"

  mkdir -p "$(dirname "$STATE_FILE")"
  echo "$pt" > "$STATE_FILE"

  # 1. Foot font
  if [[ -f ~/.config/foot/foot.ini ]]; then
    if grep -q "^font=" ~/.config/foot/foot.ini; then
      sed -i -E "s/^(font=.*:size=)[0-9.]+/\1$pt/" ~/.config/foot/foot.ini
    else
      sed -i -E "/^\[main\]/a font=$mono_family:size=$pt" ~/.config/foot/foot.ini
    fi
    touch ~/.config/foot/foot.ini 2>/dev/null || true
  fi

  # 2. Ghostty
  if [[ -f ~/.config/ghostty/config ]]; then
    if grep -q "^font-size = " ~/.config/ghostty/config; then
      sed -i -E "s/^font-size = .*/font-size = $pt/" ~/.config/ghostty/config
    else
      echo "font-size = $pt" >> ~/.config/ghostty/config
    fi
    pkill -SIGUSR2 ghostty 2>/dev/null || true
  fi

  # 3. Kitty
  if [[ -f ~/.config/kitty/kitty.conf ]]; then
    sed -i -E "s/^font_size[[:space:]]+.*/font_size $pt.0/" ~/.config/kitty/kitty.conf
    pkill -USR1 kitty 2>/dev/null || true
  fi

  # 4. Alacritty
  if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
    sed -i -E "s/^size[[:space:]]*=.*/size = $pt/" ~/.config/alacritty/alacritty.toml
  fi

  echo "Set terminal font size to ${pt}pt"
}

case "${1:-}" in
  ""|get)
    get_size
    ;;
  sync)
    cur=$(get_size)
    set_size "$cur"
    ;;
  [0-9]*)
    val="$1"
    if (( val < MIN || val > MAX )); then
      echo "Size must be between $MIN and $MAX pt" >&2
      exit 1
    fi
    set_size "$val"
    ;;
  *)
    echo "Usage: $0 [get|sync|<size_pt>]"
    exit 1
    ;;
esac
