#!/usr/bin/env bash
# ==============================================================================
# Independent Terminal Typography Scaler for Foot, Ghostty, Kitty, Alacritty
# ==============================================================================

set -euo pipefail

STATE_FILE="$HOME/.local/state/omarchy/terminal-font-size"
MIN=8
MAX=24

get_size() {
  if [[ -f "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    echo "11"
  fi
}

set_size() {
  local pt="$1"
  local mono_family
  mono_family="$(omarchy-font-current 2>/dev/null || echo "Adwaita Mono")"
  [[ -n "$mono_family" ]] || mono_family="Adwaita Mono"

  mkdir -p "$(dirname "$STATE_FILE")"
  echo "$pt" > "$STATE_FILE"

  # 1. Foot font
  if [[ -f "$HOME/.config/foot/foot.ini" ]]; then
    if grep -q "^[[:space:]]*font=" "$HOME/.config/foot/foot.ini"; then
      if grep -q ":size=" "$HOME/.config/foot/foot.ini"; then
        sed -i -E "s/^([[:space:]]*font=.*:size=)[0-9.]+/\1$pt/" "$HOME/.config/foot/foot.ini"
      else
        sed -i -E "s/^([[:space:]]*font=.*)/\1:size=$pt/" "$HOME/.config/foot/foot.ini"
      fi
    elif grep -q "^\[main\]" "$HOME/.config/foot/foot.ini"; then
      sed -i -E "/^\[main\]/a font=$mono_family:size=$pt" "$HOME/.config/foot/foot.ini"
    else
      printf "\n[main]\nfont=%s:size=%s\n" "$mono_family" "$pt" >> "$HOME/.config/foot/foot.ini"
    fi
    touch "$HOME/.config/foot/foot.ini" 2>/dev/null || true
  fi

  # 2. Ghostty font
  if [[ -f "$HOME/.config/ghostty/config" ]]; then
    if grep -q "^[[:space:]]*font-size[[:space:]]*=" "$HOME/.config/ghostty/config"; then
      sed -i -E "s/^[[:space:]]*font-size[[:space:]]*=.*/font-size = $pt/" "$HOME/.config/ghostty/config"
    else
      echo "font-size = $pt" >> "$HOME/.config/ghostty/config"
    fi
    pkill -SIGUSR2 ghostty 2>/dev/null || true
  fi

  # 3. Kitty font
  if [[ -f "$HOME/.config/kitty/kitty.conf" ]]; then
    if grep -q "^[[:space:]]*font_size" "$HOME/.config/kitty/kitty.conf"; then
      sed -i -E "s/^[[:space:]]*font_size[[:space:]]+.*/font_size $pt.0/" "$HOME/.config/kitty/kitty.conf"
    else
      echo "font_size $pt.0" >> "$HOME/.config/kitty/kitty.conf"
    fi
    pkill -USR1 kitty 2>/dev/null || true
  fi

  # 4. Alacritty font
  if [[ -f "$HOME/.config/alacritty/alacritty.toml" ]]; then
    if grep -q "^[[:space:]]*size[[:space:]]*=" "$HOME/.config/alacritty/alacritty.toml"; then
      sed -i -E "s/^[[:space:]]*size[[:space:]]*=.*/size = $pt/" "$HOME/.config/alacritty/alacritty.toml"
    fi
    touch "$HOME/.config/alacritty/alacritty.toml" 2>/dev/null || true
  fi

  echo "Set terminal font size to ${pt}pt"
}

case "${1:-}" in
  ""|get)
    get_size
    ;;
  sync)
    cur=$(get_size)
    set_size "$cur"
    ;;
  [0-9]*)
    val="$1"
    if (( val < MIN || val > MAX )); then
      echo "Size must be between $MIN and $MAX pt" >&2
      exit 1
    fi
    set_size "$val"
    ;;
  *)
    echo "Usage: $0 [get|sync|<size_pt>]"
    exit 1
    ;;
esac
